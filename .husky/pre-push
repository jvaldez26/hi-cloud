#!/bin/sh
set -e

echo ""
echo "🔨 Pre-push: verificando build de producción..."
echo "─────────────────────────────────────────────────"
echo "   (Este check tarda ~25s — nunca omitirlo)"
echo ""

# ── Validación de entidades TypeORM (evita DataTypeNotSupportedError en deploy) ─
# TypeORM 0.3.28 requiere type explícito cuando el campo usa !: string | null
# (genera metadata Object, no String). Columnas con type: 'text'/'date'/'varchar' están BIEN.
# SOLO peligroso: @Column({ length: xxx }) sin ningún type: seguido de !: string | null.
ENTITY_DIR="hi-cloud backend-project/backend/src"
BAD=$(node -e "
const fs = require('fs');
const path = require('path');
function walk(dir) {
  let r = [];
  for (const f of fs.readdirSync(dir)) {
    const fp = path.join(dir, f);
    if (fs.statSync(fp).isDirectory()) r = r.concat(walk(fp));
    else if (f.endsWith('.entity.ts')) r.push(fp);
  }
  return r;
}
const bad = [];
for (const file of walk('$ENTITY_DIR')) {
  const lines = fs.readFileSync(file, 'utf8').split('\n');
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    // Patrón inline: @Column({...}) field!: string | null;  en la misma línea
    if (line.includes('!: string | null') && line.includes('@Column(') && !line.includes('type:')) {
      bad.push(file + ':' + (i+1) + ': ' + line.trim() + '  ← falta type: explícito');
    }
    // Patrón multi-línea: @Column({...}) en línea anterior sin type:
    if (i > 0 && line.includes('!: string | null') && !line.includes('@Column(')) {
      const prev = lines[i-1].trim();
      if (prev.startsWith('@Column(') && !prev.includes('type:')) {
        bad.push(file + ':' + (i+1) + ': ' + line.trim() + '  ← falta type: en @Column anterior');
      }
    }
  }
}
if (bad.length > 0) { console.log(bad.join('\n')); process.exit(1); }
" 2>&1 || true)

if echo "$BAD" | grep -q "falta type:"; then
  echo "❌ ERROR: Entidades con patrón incompatible con TypeORM 0.3.28:"
  echo ""
  echo "$BAD"
  echo ""
  echo "   SOLUCIÓN: Cambiar '!: string | null' → '?: string' en columnas sin type explícito."
  echo "   Ejemplo MALO:  @Column({ length: 100, nullable: true }) nombre!: string | null;"
  echo "   Ejemplo BUENO: @Column({ length: 100, nullable: true }) nombre?: string;"
  echo ""
  echo "   Con type explícito sí está permitido:"
  echo "   @Column({ type: 'text', nullable: true }) descripcion!: string | null; // OK"
  echo ""
  exit 1
fi

# ── Security pattern check (patrones de vulnerabilidad conocidos) ────
cd "hi-cloud backend-project/backend"
if ! bash scripts/security-check.sh; then
  echo ""
  echo "❌ PROBLEMAS DE SEGURIDAD DETECTADOS"
  echo "   Corrige los errores antes de hacer push."
  echo "   Ver detalles arriba."
  echo ""
  exit 1
fi
cd "../.."

# ── Frontend build (el más crítico — es lo que ve el usuario) ─────
cd "hi-cloud frontend-project"
if ! npm run build 2>&1; then
  echo ""
  echo "❌ BUILD DE PRODUCCIÓN FALLÓ"
  echo "   El push ha sido rechazado."
  echo ""
  echo "   NUNCA hagas push de código que no compila en producción."
  echo "   Corrige el error y vuelve a intentarlo."
  echo ""
  echo "   Si el sistema está caído, ejecuta rollback:"
  echo "   git revert HEAD --no-edit && git push origin main"
  exit 1
fi

echo ""
echo "─────────────────────────────────────────────────"
echo "✅ Build de producción OK — push permitido"
echo ""
