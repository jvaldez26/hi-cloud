#!/bin/sh
set -e

echo ""
echo "🔨 Pre-push: verificando build de producción..."
echo "─────────────────────────────────────────────────"
echo "   (Este check tarda ~25s — nunca omitirlo)"
echo ""

# ── Validación de entidades TypeORM (evita DataTypeNotSupportedError en deploy) ─
# TypeORM 0.3.28 requiere metadata type=String para inferir varchar.
# "!: string | null" sin type explícito → metadata Object → falla en producción.
# Columnas con type: 'text', type: 'date', type: 'int', etc. están BIEN.
# Solo es un problema cuando @Column({ length: xxx }) sin type: implícitamente
# intenta inferir varchar pero recibe metadata Object.
ENTITY_DIR="hi-cloud backend-project/backend/src"
# Buscar entidades con `@Column({` sin type: seguidas de `!: string | null`
BAD=$(node -e "
const fs = require('fs');
const path = require('path');
function walk(dir) {
  let results = [];
  for (const f of fs.readdirSync(dir)) {
    const fp = path.join(dir, f);
    if (fs.statSync(fp).isDirectory()) results = results.concat(walk(fp));
    else if (f.endsWith('.entity.ts')) results.push(fp);
  }
  return results;
}
const files = walk('$ENTITY_DIR');
const bad = [];
for (const file of files) {
  const lines = fs.readFileSync(file, 'utf8').split('\n');
  for (let i = 1; i < lines.length; i++) {
    const prev = lines[i-1].trim();
    const curr = lines[i].trim();
    if (curr.includes('!: string | null') && prev.startsWith('@Column(') && !prev.includes(\"type:\")) {
      bad.push(file + ':' + (i+1) + ': ' + curr + '  ← @Column sin type explícito');
    }
  }
}
if (bad.length > 0) { console.log(bad.join('\n')); process.exit(1); }
" 2>&1 || true)

if echo "$BAD" | grep -q "@Column sin type explícito"; then
  echo "❌ ERROR: Entidades con patrón incompatible con TypeORM 0.3.28:"
  echo ""
  echo "$BAD"
  echo ""
  echo "   SOLUCIÓN: Cambiar '!: string | null' → '?: string' en columnas sin type explícito."
  echo "   Ejemplo MALO:  @Column({ length: 100, nullable: true }) nombre!: string | null;"
  echo "   Ejemplo BUENO: @Column({ length: 100, nullable: true }) nombre?: string;"
  echo ""
  echo "   Con type explícito sí está permitido:"
  echo "   @Column({ type: 'text', nullable: true }) descripcion!: string | null; // OK"
  echo ""
  exit 1
fi

# ── Frontend build (el más crítico — es lo que ve el usuario) ─────
cd "hi-cloud frontend-project"
if ! npm run build 2>&1; then
  echo ""
  echo "❌ BUILD DE PRODUCCIÓN FALLÓ"
  echo "   El push ha sido rechazado."
  echo ""
  echo "   NUNCA hagas push de código que no compila en producción."
  echo "   Corrige el error y vuelve a intentarlo."
  echo ""
  echo "   Si el sistema está caído, ejecuta rollback:"
  echo "   git revert HEAD --no-edit && git push origin main"
  exit 1
fi

echo ""
echo "─────────────────────────────────────────────────"
echo "✅ Build de producción OK — push permitido"
echo ""
