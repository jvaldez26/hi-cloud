# ============================================================================
# HiCloud ERP — Variables de entorno (Backend)
# Copiar este archivo a .env y completar los valores
# NUNCA commitear el archivo .env con valores reales
# ============================================================================

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://hicloudrd.com

# ── Base de datos (AWS RDS PostgreSQL) ────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_NAME=hicloud
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=15m

# ── e-CF DGII / MSeller ───────────────────────────────────────────────────────
ECF_AMBIENTE=pruebas
ECF_RNC_EMISOR=your-rnc-9-digits
ECF_RAZON_SOCIAL=Tu Empresa S.R.L.
ECF_PROVEEDOR_URL=https://ecf.api.mseller.app
ECF_PROVEEDOR_API_KEY=your-mseller-api-key
ECF_ENCRYPTION_KEY=your-32-char-encryption-key

# ── SMTP (correo) ─────────────────────────────────────────────────────────────
# Usar Google Workspace con App Password (16 chars sin espacios)
# Gmail: myaccount.google.com → Seguridad → Contraseñas de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@hicloudrd.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="HiCloud iERP <noreply@hicloudrd.com>"

# ── Notificaciones ────────────────────────────────────────────────────────────
NOTIF_ENABLED=true
NOTIF_ADMIN_EMAIL=admin@hicloudrd.com
NOTIF_CXC_DIAS_ALERTA=30
NOTIF_CXP_DIAS_ALERTA=7

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-2
# AWS_S3_BUCKET=hicloud-erp-assets
# AWS_S3_BACKUP_BUCKET=hicloud-backups-xxxxxxxxxx

# ── Credenciales de AWS ───────────────────────────────────────────────────────
#
# NO pongas AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY aquí.
#
# El script de respaldo ya se autentica con el perfil `hicloud-backup` de
# ~/.aws/credentials. Repetir la misma clave en este .env significaría el mismo
# secreto en dos archivos: el día que se rote uno, el otro deja de funcionar en
# silencio y nadie se entera hasta que hace falta.
#
# En su lugar, el backend apunta al MISMO archivo de credenciales. Estas dos
# variables no son secretos, son punteros:
#
#   AWS_PROFILE=hicloud-backup
#   AWS_SHARED_CREDENTIALS_FILE=/home/ubuntu/.aws/credentials
#
# El SDK v3 las respeta por su cadena de proveedores por defecto, así que no
# hace falta tocar código: `new S3Client({ region })` las recoge solo.
#
# AWS_SHARED_CREDENTIALS_FILE va explícito a propósito. Si el proceso arranca
# bajo systemd sin HOME definido, `~/.aws` no resuelve y el SDK se queda sin
# credenciales — que es exactamente el fallo que hay que evitar.
#
# LO IDEAL a medio plazo es un rol IAM en la instancia: sin claves de larga
# duración en ningún archivo, y el script y el backend usando la misma
# identidad. Estas dos variables sobran el día que exista ese rol.
AWS_PROFILE=hicloud-backup
AWS_SHARED_CREDENTIALS_FILE=/home/ubuntu/.aws/credentials

# ── Push Notifications (VAPID) ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@hicloudrd.com

# ── Asistente IA (opcional) ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
