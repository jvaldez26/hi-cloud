VITE_API_URL=http://localhost:3000/api/v1

# Sentry (frontend) — el DSN del browser es PÚBLICO por diseño (va en el bundle).
# En build local queda vacío → Sentry NO inicializa (no-op). En CI lo inyecta el pipeline.
VITE_SENTRY_DSN=
# Release del build. En CI = github.sha; en local puede quedar vacío.
VITE_SENTRY_RELEASE=
